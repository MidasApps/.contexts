# BigQuery / Google Cloud
BIGQUERY_PROJECT_ID=your-bigquery-project-id
BIGQUERY_LOCATION=US
BIGQUERY_DATASET=dataviz
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI (for AI SDK)
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# Geração 3 do Gemini só responde no endpoint `global` (medido: negada em
# us-central1, southamerica-east1, us-east5, europe-west4). Ver ADR-0021.
GOOGLE_VERTEX_LOCATION=global
# For local dev: run `gcloud auth application-default login`
# For production: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Firebase Auth
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
ADMIN_EMAIL_DOMAIN=your-company.com
NEXT_PUBLIC_ADMIN_EMAIL_DOMAIN=your-company.com

# Embedded mode (iframe com token do shell pai) — allowlist de origens confiáveis,
# separadas por vírgula. FAIL-CLOSED: se vazio, o modo embedded fica desligado
# (nenhuma origem aceita, nenhum AUTH_READY enviado). Ex.: https://shell.exemplo.com,https://app.parceiro.com
NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=

# Firecrawl
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# Storage: memória de IA, RAG/embeddings e catálogo SQL vivem no Firestore
# (ADR-0013 supersede ADR-0004 — Postgres/Cloud SQL/pgvector descontinuado).

# SQL generations observability (Sprint 1.C)
SQL_GENERATIONS_LOGGING=false

# RAG / Embeddings (ADR-0005, ADR-0012)
RAG_EMBEDDING_PROVIDER=vertex            # vertex | openai
RAG_EMBEDDING_MODEL=gemini-embedding-001
RAG_RERANK_MODEL=gemini-2.5-flash
RAG_TOPK_RETRIEVE=20
RAG_TOPK_RERANK=5
RAG_INGEST_BATCH_SIZE=20
OPENAI_API_KEY=                          # somente se RAG_EMBEDDING_PROVIDER=openai
# ⚠️ O provider `openai` é OPCIONAL por design (ADR-0005): o pacote
# `@ai-sdk/openai` NÃO está no package.json e é carregado por require dinâmico.
# Usar RAG_EMBEDDING_PROVIDER=openai sem `pnpm add @ai-sdk/openai` antes
# lança MODULE_NOT_FOUND em runtime.
RAG_EXTRACTOR_MODEL=                     # default no código; extrator de metadados do RAG
RAG_CLIENT_ID=                           # scripts rag:ingest / rag:refresh — default: primeiro TENANT_IDS
RAG_DOCS_DIR=                            # scripts rag:* — default: docs/benchmarking

# ── Firebase Admin (server) ────────────────────────────────────────────────
# Opcionais: sem eles o Admin SDK cai em ADC (gcloud auth application-default
# login, ou a service account do Cloud Run). Em Docker, use GOOGLE_APPLICATION_
# CREDENTIALS apontando para a chave montada — ver .env.docker.example.
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── BigQuery / Firestore ───────────────────────────────────────────────────
BIGQUERY_CREDENTIALS=                    # caminho da chave de SA só para o BigQuery
# Banco Firestore do app. Servidor lê DATAVIZ_DATABASE_ID; o navegador lê
# NEXT_PUBLIC_DATAVIZ_DATABASE_ID, embutido no bundle no build (em Docker/Cloud
# Run entra como build-arg). Os dois devem ter o MESMO valor.
# FIRESTORE_DATABASE_ID / NEXT_PUBLIC_FIRESTORE_DATABASE_ID não são lidos pelo
# app; só alguns scripts de seed aceitam FIRESTORE_DATABASE_ID como fallback.
DATAVIZ_DATABASE_ID=                     # default: dataviz
DATA_SOURCE_ID=your-gcp-project-id       # id do doc dataSources/ = id do projeto GCP (o front monta "<dataSourceId>.<dataset>", lido como projeto.dataset pelo filter-options e pelas tools de IA)
NEXT_PUBLIC_DATAVIZ_DATABASE_ID=         # idem, lado cliente

# ── Export de PDF ──────────────────────────────────────────────────────────
# Só para rodar FORA do container: a imagem já instala Chromium e define
# CHROME_PATH (ver Dockerfile). Sem executável, /api/export-pdf falha.
CHROME_PATH=

# ── Emuladores (dev) ───────────────────────────────────────────────────────
# Qualquer um destes ativa o bypass de auth em NODE_ENV=development.
NEXT_PUBLIC_FIREBASE_EMULATOR=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# ── BQML (gating de custo) ─────────────────────────────────────────────────
BQML_TIMEOUT=
BQML_APPROVAL_BYTES_THRESHOLD=           # limiar de aprovação do treino; default = metade de BQ_MAX_BYTES_BILLED; só vale abaixo do teto
BQML_APPROVAL_COST_USD=
BQML_INVOCATIONS_LOGGING=

# ── Evals / catálogo SQL ───────────────────────────────────────────────────
EVAL_JUDGE_MODEL=
EVAL_DAILY_BUDGET_USD=
EVAL_GOLD_OUTPUT_PATH=
JUDGE_MODEL_VERSION=
GLOSSARY_VERSION=
REGULATORY_PACK_VERSION=                 # carimbado na aprovação/revalidação do catálogo

# ── Diversos ───────────────────────────────────────────────────────────────
FILL_LAYOUT_CONCURRENCY=                 # paralelismo do fill de layout do canvas
MACRO_LIVE=                              # `true` busca indicadores macro reais (BCB SGS)
NEXT_PUBLIC_EMBED_ALLOWED_ORIGINS=       # origens do modo embutido; vazio = embedded desligado (fail-closed)
CSP_REPORT_ONLY=                         # `true` faz o navegador REPORTAR violação de CSP sem bloquear (janela de observação em homologação); qualquer outro valor bloqueia
CHAT_HISTORY_BUDGET_CHARS=               # orçamento de histórico do chat antes de podar tool parts; default 120000 (~30k tokens)
BQ_MAX_BYTES_BILLED=                     # teto DURO por query (BQ rejeita antes de faturar); default 5 GiB

# ── Playground local do Mastra (`pnpm mastra:dev`, só local, sem auth) ─────
MASTRA_DEV_CLIENT_ID=                    # cliente fixo do playground; default vila-rosa
MASTRA_DEV_DATASET=                      # override do dataset; default = dataset principal do cliente no Firestore
MASTRA_DEV_USER_EMAIL=                   # e-mail em nome de quem as tools de métrica agem; vazio = elas recusam escrever
MASTRA_DEV_DATE_START=                   # YYYY-MM-DD; default 1º de janeiro do ano de DATE_END
MASTRA_DEV_DATE_END=                     # YYYY-MM-DD; default hoje
MASTRA_DEV_ALLOW_PROD=                   # `1` permite subir contra DATAVIZ_DATABASE_ID=dataviz (produção)
