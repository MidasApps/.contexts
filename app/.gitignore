# Dependencies and build output
node_modules/
dist/
.next/
next-env.d.ts
.turbo/
.tscache/
.mastra/
*.tsbuildinfo

# Local-only data and secrets (only .env.example is versioned)
.env
.env.*
!.env.example
# Desktop Vite env for `vite`/`tauri dev`: public VITE_* values only.
!apps/desktop/.env.development
.firebase-data/

# Test and coverage output
coverage/
playwright-report/
test-results/
# Eval reports of `pnpm evals` / `pnpm evals:real` (decision 0028).
.evals/
# Playwright storage states and the seeded world of the e2e run (session cookies).
**/e2e/.auth/

# Tool logs
*-debug.log
firebase-debug.log
ui-debug.log

# Tauri/Rust build output (**/: a mid-pattern slash would anchor it to app/)
**/src-tauri/target/
# gen/schemas is regenerated by tauri-build on every build (gen/android and
# gen/apple, once created, are versioned); tauri.api.conf.json is written by
# apps/desktop/scripts/write-tauri-api-config.ts from VITE_API_URL.
**/src-tauri/gen/schemas/
**/src-tauri/tauri.api.conf.json

# Functions: lib/ is the generated deploy source (apps/functions/build.ts).
# .env.demo-core only holds non-secret emulator config for the demo project.
apps/functions/lib/
!apps/functions/.env.demo-core
