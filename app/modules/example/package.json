{
  "name": "@core/module-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "exports": {
    "./manifest": "./src/manifest.ts",
    "./contracts": "./src/contracts/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server/index.ts",
    "./agents": "./src/agents/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:emulators": "vitest run --project emulators",
    "test:postgres": "vitest run --project postgres"
  },
  "dependencies": {
    "@core/agents": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/services": "workspace:*",
    "@mastra/core": "catalog:",
    "firebase-admin": "catalog:",
    "zod": "catalog:"
  },
  "//peerDependencies": "@core/client is an optional peer: only the apps that render the module's pages (web, desktop) install it; the agent runtime loads ./manifest, ./server and ./agents without the client tree.",
  "peerDependencies": {
    "@core/client": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "use-intl": "catalog:"
  },
  "peerDependenciesMeta": {
    "@core/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@core/client": "workspace:*",
    "@core/config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "use-intl": "catalog:",
    "vitest": "catalog:"
  }
}
