# Copy to .env.local (gitignored) and fill the blanks: `cp .env.example .env.local`.
# Placeholders only; never put a real secret here (contracts/secrets.md §13).
# Local always runs against emulators and the demo-core project, never a remote
# project (processes/environments.md §9).

# --- Runtime ---------------------------------------------------------------
# Lib mode: development only in local; production in dev/staging/prod.
NODE_ENV=development
# Logical environment: local | dev | staging | prod.
APP_ENV=local
# real (schema default) calls the configured providers and needs the key of each
# text role's provider; fake (scripted models, offline) is allowed only in
# local/dev, so a fresh local setup runs without keys (decision 0021).
AI_MODE=fake

# --- Firebase (Emulator Suite, ports from firebase.json) -------------------
# demo-* project ids can never reach a real Firebase project.
FIREBASE_PROJECT_ID=demo-core
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PUBSUB_EMULATOR_HOST=127.0.0.1:8085

# Bucket of uploads (files context: signed URLs, onObjectFinalized). Local default when
# unset: <FIREBASE_PROJECT_ID>.appspot.com (the emulator default bucket); required
# outside local for web and Mastra. The Functions trigger reads FILES_BUCKET from its
# own .env.<projectId> (unset = default bucket).
FILES_BUCKET=demo-core.appspot.com

# Public web config (NEXT_PUBLIC_* is public by contract; never a secret).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-core
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-core.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-core.appspot.com
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Environment the browser bundle runs in; must equal APP_ENV (the web refuses to boot otherwise).
NEXT_PUBLIC_APP_ENV=local

# --- Identity and access (decisions 0007, 0008) -----------------------------
# Web session cookie lifetime in days (1-14).
SESSION_MAX_AGE_DAYS=5
# Desktop session lifetime in days, sliding (1-90).
DESKTOP_SESSION_MAX_AGE_DAYS=30
# Prefix of API keys (<prefix>_<publicId>_<secret>); 2-12 lower-case letters.
API_KEY_PREFIX=core
# true lets any signed-in user create an organization; false limits it to staff.
ORGANIZATION_SELF_SERVE=true
# Second factors offered by the UI (comma-separated: totp, phone). Remote
# environments use totp; the Auth Emulator has no TOTP, so local uses phone (SMS).
MFA_FACTORS=phone
# The same list for the web UI (public; inlined into the browser bundle).
NEXT_PUBLIC_MFA_FACTORS=phone
# Open sign-up page /sign-up (decision 0050): true|false, unset = accounts only from invitations.
NEXT_PUBLIC_SELF_SERVE_SIGN_UP=true
# Proxies in front of the app that append an X-Forwarded-For entry (decision 0030 §2):
# 1 for App Hosting / Cloud Run behind Google's front end, 2 with an external HTTPS
# load balancer in front. Per-IP rate limits use the entry the outermost one appended.
TRUSTED_PROXY_HOPS=1

# --- Postgres (docker-compose.yml) -----------------------------------------
# Container credentials; local-only defaults. Change POSTGRES_PORT if 5432 is
# taken and keep DATABASE_URL in sync.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app

# --- AI providers (server-only; ask the team for dev keys) -----------------
# Leave empty with AI_MODE=fake.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Agent runtime (apps/mastra; spec SP3 §15) -------------------------------
# Model per role as <provider>/<model> (google | openai | anthropic); unset uses
# the defaults of decision 0021. Each role also takes AI_MODEL_<ROLE>_FALLBACK.
# AI_MODEL_CHAT=google/gemini-3.5-flash
# AI_MODEL_FAST=google/gemini-3.5-flash-lite
# AI_MODEL_REASONING=google/gemini-3.5-flash
# AI_MODEL_JUDGE=google/gemini-3.5-flash
# AI_MODEL_EMBEDDING=google/gemini-embedding-2
# AI_MODEL_TRANSCRIPTION=openai/gpt-transcribe
# AI_MODEL_SPEECH=openai/gpt-4o-mini-tts
# AI_MODEL_REALTIME=openai/gpt-realtime-2.1
# ai-studio uses GOOGLE_GENERATIVE_AI_API_KEY; vertex uses ADC plus project/location.
GOOGLE_AI_BACKEND=ai-studio
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
# Web tools (tenant opt-in); empty disables them.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
AI_MEMORY_OBSERVATIONAL=false
AI_KB_RERANK=false
# >= 32 bytes outside local (secret); local falls back to a fixed non-secret key.
MCP_REQUEST_STATE_KEY=
# OTLP/HTTP traces endpoint (Cloud Trace outside local); empty = storage exporter only.
OTEL_EXPORTER_OTLP_ENDPOINT=
# memory | gcp
MASTRA_PUBSUB=memory
# auto (local) | skip (required outside local; run `pnpm -F @core/mastra db:init` in deploy).
MASTRA_STORAGE_INIT=
# Minimum minutes between two fires of a tenant schedule (decision 0037). Default 15; values below
# 15 apply only with APP_ENV=local (the e2e uses 1).
SCHEDULE_MIN_INTERVAL_MINUTES=
# none | bigquery
USAGE_SINK=none
BIGQUERY_DATASET_AI_OBSERVABILITY=ai_observability

# --- Local dev servers -----------------------------------------------------
# Port of `next dev` (apps/web/scripts/next-dev.ts); not PORT, which Mastra reads.
# If you change it, update NEXT_PUBLIC_APP_URL and the desktop VITE_API_URL too.
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MASTRA_URL=http://localhost:4111
# /v1 gateway to Mastra outside local: MASTRA_URL must be https, plus the Cloud Run
# audience for X-Serverless-Authorization (both required outside local).
# MASTRA_AUDIENCE=https://mastra-<hash>.a.run.app

# --- Web /v1 CORS (apps/web) -------------------------------------------------
# Comma-separated origins allowed to call /v1 cross-origin; never *, no
# credentials (Bearer only). Local default when unset: the desktop Vite dev
# server and the Tauri webview (tauri://localhost on macOS/Linux,
# http://tauri.localhost on Windows). Required outside local; empty = CORS off.
CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost

# --- Desktop (apps/desktop) ------------------------------------------------
# The desktop app reads only VITE_* values from apps/desktop/.env.development
# (committed, public) or .env.production / the build env. VITE_* is public by
# contract (bundled into the client): never a secret. VITE_API_URL is the web
# /v1 origin (scheme://host[:port]; plain http only for loopback), e.g.
# http://localhost:3000 locally. `pnpm -F desktop tauri:dev|tauri:build` derive
# the Tauri CSP connect-src from the same value (scripts/write-tauri-api-config.ts).
# Release builds: copy apps/desktop/.env.production.example to .env.production
# (gitignored) or pass the VITE_* variables in the build env. If you move the
# Storage Emulator port, update VITE_STORAGE_EMULATOR_URL in .env.development.

# --- Mastra server (apps/mastra) --------------------------------------------
# localhost for `mastra dev`; the container image sets 0.0.0.0 (spec §16.3).
MASTRA_HOST=localhost
# Port comes from PORT (default 4111; the image sets 8081). Keep it commented
# here: this file is shared and `next dev` also reads PORT.
# PORT=4111
# debug | info | warn | error
LOG_LEVEL=info
# Server timeout in ms (default 900000 = 15 min; Mastra's 180 s default cuts
# long streams). Max 3600000, Cloud Run's request ceiling.
MASTRA_SERVER_TIMEOUT_MS=900000
# Local-only CORS allowlist on top of Studio's own origin (never *): web,
# desktop Vite dev server and the Tauri webview. Ignored outside local (CORS off).
MASTRA_CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost
# Opt out of Mastra CLI/server usage telemetry (conservative default under LGPD).
MASTRA_TELEMETRY_DISABLED=1

# --- Local seed (scripts/seed-local.ts) -------------------------------------
# Passwords of the seeded accounts in the Auth Emulator (6+ chars). Empty or
# unset uses the local-only default demo-<user>-password (demo-owner-password,
# demo-member-password, ...); the seed refuses any target but the emulators of a
# demo-* project.
SEED_OWNER_PASSWORD=
SEED_MEMBER_PASSWORD=
SEED_VIEWER_PASSWORD=
SEED_INVITEE_PASSWORD=
SEED_STAFF_PASSWORD=
