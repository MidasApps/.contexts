# Copy to .env.local (gitignored) and fill the blanks: `cp .env.example .env.local`.
# Placeholders only; never put a real secret here (contracts/secrets.md §13).
# Local always runs against emulators and the demo-core project, never a remote
# project (processes/environments.md §9).

# --- Runtime ---------------------------------------------------------------
# Lib mode: development only in local; production in dev/staging/prod.
NODE_ENV=development
# Logical environment: local | dev | staging | prod.
APP_ENV=local
# real (default) calls the configured provider; fake is the explicit CI/test/offline mode.
AI_MODE=real

# --- Firebase (Emulator Suite, ports from firebase.json) -------------------
# demo-* project ids can never reach a real Firebase project.
FIREBASE_PROJECT_ID=demo-core
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PUBSUB_EMULATOR_HOST=127.0.0.1:8085

# Public web config (NEXT_PUBLIC_* is public by contract; never a secret).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-core
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-core.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-core.appspot.com
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# --- Postgres (docker-compose.yml) -----------------------------------------
# Container credentials; local-only defaults. Change POSTGRES_PORT if 5432 is
# taken and keep DATABASE_URL in sync.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app

# --- AI providers (server-only; ask the team for dev keys) -----------------
# Leave empty with AI_MODE=fake.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Local dev servers -----------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
MASTRA_URL=http://localhost:4111
