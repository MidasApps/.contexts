# Copy to .env.production (gitignored) for `pnpm -F @core/desktop build` / `tauri:build`, or pass
# the same VITE_* variables in the shell or CI env (they win over this file).
# Public values only: every VITE_* variable is bundled into the client; never a secret.
# The values below are placeholders that pass validation, so a clean checkout can build; a bundle
# built with them cannot reach any API (`.invalid` never resolves). Replace all of them with the
# values of the target environment before a release.

# Web /v1 origin (https; scheme://host[:port], no path). The Tauri CSP connect-src derives from it.
VITE_API_URL=https://api.example.invalid
# dev | staging | prod (local belongs in .env.development).
VITE_APP_ENV=staging
# Firebase web config of the target project (public identifiers).
VITE_FIREBASE_API_KEY=replace-with-the-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
# Comma list of totp|phone; remote environments use totp.
VITE_MFA_FACTORS=totp
# VITE_AUTH_EMULATOR_URL and VITE_STORAGE_EMULATOR_URL are local only: never set them here.
