# Public values only: every VITE_* variable is bundled into the client.
# Web /v1 origin for `vite` / `tauri dev`; override per shell (VITE_API_URL=...)
# or in .env.development.local (gitignored). Release builds read .env.production
# or the CI env; `pnpm tauri:build` derives the CSP connect-src from the same value.
VITE_API_URL=http://localhost:3000
