# Public values only: every VITE_* variable is bundled into the client.
# Local development against `pnpm dev` (web on WEB_PORT=3100, Emulator Suite on the
# default ports, project demo-core). Override per shell (VITE_API_URL=...) or in
# .env.development.local (gitignored). Release builds read .env.production or the CI
# env; `pnpm tauri:build` derives the CSP connect-src from the same values.
VITE_API_URL=http://localhost:3100
VITE_APP_ENV=local
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-core.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-core
# Required in local, forbidden elsewhere (follow-up #12c).
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Local only: where chat uploads send their bytes (Storage Emulator of firebase.json). Only the
# Tauri CSP connect-src reads it; forbidden outside local.
VITE_STORAGE_EMULATOR_URL=http://127.0.0.1:9199
# Comma list of totp|phone: the Auth Emulator supports SMS (phone) only.
VITE_MFA_FACTORS=phone
# Open sign-up page (decision 0050): true|false, unset = accounts only from invitations.
VITE_SELF_SERVE_SIGN_UP=true
