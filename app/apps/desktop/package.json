{
  "name": "@core/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test-native",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:config": "node scripts/write-tauri-api-config.ts",
    "tauri:dev": "node scripts/write-tauri-api-config.ts development && tauri dev --config src-tauri/tauri.api.conf.json",
    "tauri:build": "node scripts/write-tauri-api-config.ts production && tauri build --config src-tauri/tauri.api.conf.json",
    "test:e2e": "playwright test",
    "test:native": "wdio run test-native/wdio.conf.ts"
  },
  "dependencies": {
    "@core/client": "workspace:*",
    "@core/contracts": "workspace:*",
    "@core/i18n": "workspace:*",
    "@core/module-example": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tauri-apps/api": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@core/config": "workspace:*",
    "@core/e2e": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@wdio/cli": "catalog:",
    "@wdio/globals": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/mocha-framework": "catalog:",
    "@wdio/spec-reporter": "catalog:",
    "@wdio/tauri-service": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webdriverio": "catalog:"
  }
}
