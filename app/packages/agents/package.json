{
  "name": "@core/agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:postgres": "vitest run --project postgres --passWithNoTests",
    "test:emulators": "vitest run --project emulators --passWithNoTests",
    "evals": "vitest run --project evals --passWithNoTests",
    "evals:real": "vitest run --project evals-real --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/google-vertex": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/provider": "catalog:",
    "@apidevtools/swagger-parser": "catalog:",
    "@core/contracts": "workspace:*",
    "@core/services": "workspace:*",
    "@mastra/ai-sdk": "catalog:",
    "@mastra/core": "catalog:",
    "@mastra/mcp": "catalog:",
    "@mastra/memory": "catalog:",
    "@mastra/observability": "catalog:",
    "@mastra/otel-exporter": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "ai": "catalog:",
    "firecrawl": "catalog:",
    "openapi-types": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@core/config": "workspace:*",
    "@mastra/deployer": "catalog:",
    "@mastra/pg": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
