{
  "name": "@core/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./app-shell": "./src/app-shell/index.ts",
    "./views/*": "./src/views/*/index.ts",
    "./widgets/*": "./src/widgets/*/index.ts",
    "./entities/*": "./src/entities/*/index.ts",
    "./shared/ui/*": "./src/shared/ui/*.tsx",
    "./shared/ui/notify": "./src/shared/ui/molecules/Toaster/notify.ts",
    "./shared/api": "./src/shared/api/index.ts",
    "./shared/config": "./src/shared/config/index.ts",
    "./shared/lib/*": "./src/shared/lib/*/index.ts",
    "./shared/lib/cn": "./src/shared/lib/cn.ts",
    "./styles.css": "./src/shared/ui/styles/globals.css",
    "./testing": "./src/app-shell/testing/index.ts",
    "./testing/setup": "./src/shared/testing/setup.ts"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@core/contracts": "workspace:*",
    "@core/i18n": "workspace:*",
    "@tanstack/react-table": "catalog:",
    "class-variance-authority": "catalog:",
