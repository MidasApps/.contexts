{
  "additionalProperties": false,
  "description": "What an invitee sees before accepting (POST /v1/invitations/preview).",
  "examples": [
    {
      "expiresAt": "2026-10-06T14:30:00.000Z",
      "inviterDisplayName": "Ana Souza",
      "maskedEmail": "c***@example.com",
      "organizationName": "Northwind"
    }
  ],
  "properties": {
    "expiresAt": {
      "description": "When the invitation stops working (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    },
    "inviterDisplayName": {
      "description": "Display name of the inviter; may be empty.",
      "type": "string",
      "x-pii": "personal"
    },
    "maskedEmail": {
      "description": "Invited email, masked (`c***@example.com`).",
      "minLength": 1,
      "type": "string",
      "x-pii": "personal"
    },
    "organizationName": {
      "description": "Name of the inviting organization.",
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    }
  },
  "required": [
    "organizationName",
    "inviterDisplayName",
    "maskedEmail",
    "expiresAt"
  ],
  "type": "object",
  "x-kind": "view",
  "x-pii": "personal",
  "x-relations": [],
  "x-tenancyScope": "user"
}
