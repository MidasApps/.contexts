                  },
                  "unitId": {
                    "description": "Unit of the node.",
                    "minLength": 1,
                    "type": "string",
                    "x-pii": "none"
                  }
                },
                "required": [
                  "level",
                  "tenantId",
                  "projectId",
                  "unitId"
                ],
                "type": "object"
              }
            ],
            "x-pii": "none"
          },
          "roles": {
