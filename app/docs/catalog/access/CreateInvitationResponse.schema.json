            {
              "additionalProperties": false,
              "properties": {
                "level": {
                  "const": "unit",
                  "description": "Level of the node.",
                  "type": "string",
                  "x-pii": "none"
                },
                "projectId": {
                  "description": "Project of the node.",
                  "minLength": 1,
                  "type": "string",
                  "x-pii": "none"
                },
                "tenantId": {
                  "description": "Organization (tenant) of the node.",
                  "minLength": 1,
                  "type": "string",
                  "x-pii": "none"
                },
                "unitId": {
                  "description": "Unit of the node.",
