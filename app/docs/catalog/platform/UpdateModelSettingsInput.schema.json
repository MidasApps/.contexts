          "type": "string",
          "x-pii": "none"
        },
        "reasoning": {
          "description": "Model that plans actions.",
          "maxLength": 120,
          "pattern": "^(google|openai|anthropic)\\/[\\w.:-]+$",
          "type": "string",
          "x-pii": "none"
        }
