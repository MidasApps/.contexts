            "pattern": "^(google|openai|anthropic)\\/[\\w.:-]+$",
            "type": "string",
            "x-pii": "none"
          },
          "outputMicroUsdPerMTok": {
            "description": "Price of 1M output tokens, in micro-USD.",
            "maximum": 1000000000000,
            "minimum": 0,
            "type": "integer",
            "x-pii": "none"
          }
        },
        "required": [
          "modelId",
          "inputMicroUsdPerMTok",
          "outputMicroUsdPerMTok"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "type": "array",
      "x-pii": "none"
    },
    "roles": {
      "additionalProperties": false,
