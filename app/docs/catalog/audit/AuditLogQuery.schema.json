        "SEMANTIC_QUERY_EXECUTED",
        "KNOWLEDGE_DOCUMENT_INDEXED",
        "KNOWLEDGE_DOCUMENT_INGESTED",
        "KNOWLEDGE_DOCUMENT_DELETED",
        "FILE_UPLOADED",
        "FILE_REJECTED",
        "CONNECTOR_CREATED",
