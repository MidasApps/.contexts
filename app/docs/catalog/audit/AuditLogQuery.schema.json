    "actorId": {
      "description": "Only entries by this actor id.",
      "minLength": 1,
      "type": "string",
      "x-pii": "personal"
    },
    "cursor": {
      "description": "Cursor returned by the previous page.",
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
