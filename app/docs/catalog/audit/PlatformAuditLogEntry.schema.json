          "pattern": "^[a-f0-9]{16,128}$",
          "type": "string",
          "x-pii": "none"
        },
        "inputHash": {
          "description": "Digest of the action input (never the input).",
          "pattern": "^[a-f0-9]{16,128}$",
          "type": "string",
          "x-pii": "none"
        },
        "runId": {
          "description": "Id of the agent or workflow run.",
          "pattern": "^[A-Za-z0-9_-]{1,128}$",
          "type": "string",
          "x-pii": "none"
        },
        "thresholdPercent": {
          "description": "Budget threshold reached, in percent of a monthly cap (SP5).",
