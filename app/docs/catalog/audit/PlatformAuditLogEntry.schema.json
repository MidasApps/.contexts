          "minimum": 1,
          "type": "integer",
          "x-pii": "none"
        },
        "toolCallId": {
          "description": "Id of the tool call an approval decision answers (SP4).",
          "pattern": "^[A-Za-z0-9_.:-]{1,200}$",
          "type": "string",
          "x-pii": "none"
        },
        "toolId": {
          "description": "Id of the agent tool (`core.search`, `mcp:server/tool`).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$",
          "type": "string",
          "x-pii": "none"
        }
      },
      "type": "object",
