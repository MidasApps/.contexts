{
  "additionalProperties": false,
  "description": "Creates an organization; the caller becomes its owner (self-serve flag, SP1 spec §6.1).",
  "examples": [
    {
      "defaults": {
        "currency": "BRL",
        "locale": "pt-BR",
        "timeZone": "America/Sao_Paulo"
      },
      "name": "Northwind"
    }
  ],
