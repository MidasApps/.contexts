{
  "additionalProperties": false,
  "description": "The next fires of a cron expression in its time zone, as the scheduler would fire them.",
  "examples": [
    {
      "nextFireTimes": [
        "2026-10-01T12:00:00.000Z",
        "2026-10-02T12:00:00.000Z",
        "2026-10-05T12:00:00.000Z",
        "2026-10-06T12:00:00.000Z",
        "2026-10-07T12:00:00.000Z"
      ]
    }
  ],
  "properties": {
    "nextFireTimes": {
      "description": "The next five fires from now (UTC), computed by the scheduler's own cron engine.",
      "items": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
        "type": "string"
      },
      "maxItems": 5,
      "type": "array",
      "x-pii": "none"
    }
  },
  "required": [
    "nextFireTimes"
  ],
  "type": "object",
  "x-kind": "view",
  "x-permission": "core.schedule.read",
  "x-pii": "none",
  "x-relations": [],
  "x-tenancyScope": "organization"
}
