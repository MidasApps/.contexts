{
  "additionalProperties": false,
  "description": "Creates a tenant schedule for a schedulable workflow.",
  "examples": [
    {
      "cron": "0 9 * * *",
      "inputData": {},
      "slug": "daily-usage",
      "timezone": "America/Sao_Paulo",
      "workflowId": "usage-report"
    }
  ],
  "properties": {
    "cron": {
      "description": "5-field cron expression; at least 15 minutes between fires.",
      "maxLength": 120,
      "type": "string",
      "x-pii": "none"
    },
    "inputData": {
      "additionalProperties": {},
      "description": "Workflow input; validated by the workflow's own schema on the server.",
      "propertyNames": {
        "type": "string"
      },
      "type": "object",
      "x-pii": "personal"
    },
    "slug": {
      "description": "Unique per organization; part of the schedule id.",
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string",
      "x-pii": "none"
    },
    "timezone": {
      "description": "IANA time zone of the cron expression; required.",
      "type": "string",
      "x-pii": "none"
    },
    "workflowId": {
      "description": "Workflow to schedule; it must be schedulable.",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string",
      "x-pii": "none"
    }
  },
  "required": [
    "workflowId",
    "slug",
    "cron",
    "timezone"
  ],
  "type": "object",
  "x-kind": "command",
  "x-permission": "core.schedule.write",
  "x-pii": "personal",
  "x-relations": [],
  "x-tenancyScope": "organization"
}
