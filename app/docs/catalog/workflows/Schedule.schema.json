{
  "additionalProperties": false,
  "description": "A tenant schedule that starts a schedulable workflow on a cron expression in an IANA time zone.",
  "examples": [
    {
      "createdAt": "2026-09-29T14:30:00.000Z",
      "createdBy": "uA1b2C3d4E5f6G7h8I9j",
      "cron": "0 9 * * *",
      "id": "schedule_3fa9c0e1b2d4a6f8-daily-usage",
      "inputData": {},
      "lastFireAt": null,
      "nextFireAt": "2026-09-30T12:00:00.000Z",
      "status": "active",
      "tenantId": "Jd8sK2lPq0WnR5tYu3bV",
      "timezone": "America/Sao_Paulo",
      "updatedAt": "2026-09-29T14:30:00.000Z",
      "workflowId": "usage-report"
    }
  ],
  "properties": {
    "createdAt": {
      "description": "When the schedule was created (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    },
    "createdBy": {
      "description": "Creator; every run re-authorizes this user.",
      "minLength": 1,
      "type": "string",
      "x-pii": "personal"
    },
    "cron": {
      "description": "5-field cron expression, evaluated in `timezone`.",
      "maxLength": 120,
      "type": "string",
      "x-pii": "none"
    },
    "id": {
      "description": "`schedule_<tenant key>-<slug>`; the tenant key is the first 16 hex digits of SHA-256(tenantId), because Mastra slugifies ids.",
      "pattern": "^schedule_[a-f0-9]{16}-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string",
      "x-pii": "none"
    },
    "inputData": {
      "additionalProperties": {},
      "description": "Workflow input; validated by the workflow's own schema on the server.",
      "propertyNames": {
        "type": "string"
      },
      "type": "object",
      "x-pii": "personal"
    },
    "lastFireAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last fire (UTC); null before the first.",
      "x-pii": "none"
    },
    "nextFireAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Next fire (UTC); null while paused.",
      "x-pii": "none"
    },
    "status": {
      "description": "`paused` schedules do not fire.",
      "enum": [
        "active",
        "paused"
      ],
      "type": "string",
      "x-pii": "none"
    },
    "tenantId": {
      "description": "Organization that owns the schedule.",
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
    "timezone": {
      "description": "IANA time zone of the cron expression.",
      "type": "string",
      "x-pii": "none"
    },
    "updatedAt": {
      "description": "When the schedule last changed (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    },
    "workflowId": {
      "description": "Scheduled workflow.",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string",
      "x-pii": "none"
    }
  },
  "required": [
    "id",
    "tenantId",
    "workflowId",
    "cron",
    "timezone",
    "inputData",
    "status",
    "nextFireAt",
    "lastFireAt",
    "createdBy",
    "createdAt",
    "updatedAt"
  ],
  "type": "object",
  "x-kind": "entity",
  "x-permission": "core.schedule.read",
  "x-pii": "personal",
  "x-relations": [
    {
      "field": "tenantId",
      "target": "tenancy.Organization",
      "type": "belongs-to"
    }
  ],
  "x-tenancyScope": "organization"
}
