              "type": "string",
              "x-pii": "none"
            },
            "projectId": {
              "description": "Project of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            },
            "tenantId": {
              "description": "Organization (tenant) of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            },
            "unitId": {
              "description": "Unit of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            }
          },
          "required": [
            "level",
            "tenantId",
            "projectId",
            "unitId"
          ],
          "type": "object"
        }
      ],
      "x-pii": "none"
    },
    "status": {
      "description": "`revoked` devices cannot sign in.",
      "enum": [
        "active",
        "revoked"
      ],
      "type": "string",
      "x-pii": "none"
    },
    "tenantId": {
      "description": "Organization the device belongs to.",
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
    "updatedAt": {
      "description": "When the device last changed (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    }
  },
  "required": [
    "id",
    "tenantId",
    "label",
    "node",
    "status",
    "lastSeenAt",
