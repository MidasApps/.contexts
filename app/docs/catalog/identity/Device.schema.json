  "properties": {
    "createdAt": {
      "description": "When the device was activated (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    },
    "id": {
      "description": "Device id; also the Firebase Auth uid of the device.",
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
    "label": {
      "description": "Name given at activation, e.g. `Front desk tablet`.",
      "maxLength": 80,
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
    "lastSeenAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last authenticated request (UTC); null before the first one.",
      "x-pii": "none"
    },
    "node": {
      "description": "Node the device was activated at; its grant lives there.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": "organization",
              "description": "Level of the node.",
              "type": "string",
              "x-pii": "none"
            },
            "tenantId": {
