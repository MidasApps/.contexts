{
  "additionalProperties": false,
  "description": "A user profile (`users/{uid}`), created on the first GET /v1/me.",
  "examples": [
    {
      "accessVersion": 3,
      "createdAt": "2026-09-29T14:30:00.000Z",
      "displayName": "Ana Souza",
      "email": "ana@example.com",
      "id": "uA1b2C3d4E5f6G7h8I9j",
      "lastContext": {
        "organizationId": "Jd8sK2lPq0WnR5tYu3bV"
      },
      "preferences": {
        "notifications": {
          "productUpdates": false,
          "securityAlerts": true
        },
        "theme": "system"
      },
      "status": "active",
      "updatedAt": "2026-09-29T15:00:00.000Z"
    }
  ],
  "properties": {
    "accessVersion": {
      "description": "Bumped on every grant change; a newer value than the token's means stale claims.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer",
      "x-pii": "none"
    },
    "createdAt": {
      "description": "When the user doc was created (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    },
    "displayName": {
      "description": "Name shown to other members; may be empty.",
      "maxLength": 120,
      "type": "string",
      "x-pii": "personal"
    },
    "email": {
      "description": "Email address of the Firebase Auth account.",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string",
      "x-pii": "personal"
    },
    "id": {
      "description": "Firebase Auth uid (document id).",
      "minLength": 1,
      "type": "string",
      "x-pii": "personal"
    },
    "lastContext": {
      "additionalProperties": false,
      "description": "Last organization, project and unit used.",
      "properties": {
        "organizationId": {
          "description": "Active organization.",
          "minLength": 1,
          "type": "string",
          "x-pii": "none"
        },
        "projectId": {
          "description": "Last project.",
          "minLength": 1,
          "type": "string",
          "x-pii": "none"
        },
        "unitId": {
          "description": "Last unit.",
          "minLength": 1,
          "type": "string",
          "x-pii": "none"
        }
      },
      "type": "object",
      "x-pii": "none"
    },
    "photoUrl": {
      "description": "Profile photo URL.",
      "format": "uri",
      "type": "string",
      "x-pii": "personal"
    },
    "preferences": {
      "additionalProperties": false,
      "description": "Locale, time zone, currency, theme, notifications.",
      "properties": {
        "currency": {
          "description": "Preferred ISO 4217 currency for display.",
          "pattern": "^[A-Z]{3}$",
          "type": "string",
          "x-pii": "personal"
        },
        "locale": {
          "description": "Preferred BCP 47 locale; absent uses the organization default.",
          "minLength": 1,
          "type": "string",
          "x-pii": "personal"
        },
        "notifications": {
          "additionalProperties": false,
          "description": "Notification opt-ins.",
          "properties": {
            "productUpdates": {
              "description": "Receive product update notices.",
              "type": "boolean",
              "x-pii": "none"
            },
            "securityAlerts": {
              "const": true,
              "description": "Security alerts are always on.",
              "type": "boolean",
              "x-pii": "none"
            }
          },
          "required": [
            "productUpdates",
            "securityAlerts"
          ],
          "type": "object",
          "x-pii": "none"
        },
        "theme": {
          "description": "Color theme.",
          "enum": [
            "system",
            "light",
            "dark"
          ],
          "type": "string",
          "x-pii": "none"
        },
        "timeZone": {
          "description": "Preferred IANA time zone for display; absent uses the node's.",
          "type": "string",
          "x-pii": "personal"
        }
      },
      "required": [
        "theme",
        "notifications"
      ],
      "type": "object",
      "x-pii": "personal"
    },
    "status": {
      "description": "`disabled` users hold no permission.",
      "enum": [
        "active",
        "disabled"
      ],
      "type": "string",
      "x-pii": "none"
    },
    "updatedAt": {
      "description": "When the user doc last changed (UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    }
  },
  "required": [
    "id",
    "email",
    "displayName",
    "preferences",
    "lastContext",
    "accessVersion",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "type": "object",
  "x-kind": "entity",
  "x-pii": "personal",
  "x-relations": [],
  "x-tenancyScope": "user"
}
