{
  "additionalProperties": false,
  "description": "One-time answer of POST /v1/me/desktop-sessions with the session secret.",
  "examples": [
    {
      "expiresAt": "2026-10-06T14:30:00.000Z",
      "secret": "q1W2e3R4t5Y6u7I8o9P0a1S2d3F4g5H6j7K8l9Z0x1C",
      "sessionId": "Ss8yH0nU2jM4iK6oL8pZ"
    }
  ],
  "properties": {
    "expiresAt": {
      "description": "When the session expires unless exchanged again (sliding, UTC).",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string",
      "x-pii": "none"
    },
    "secret": {
      "description": "Session secret, returned once; the desktop keeps it in the OS keychain.",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string",
      "x-pii": "sensitive"
    },
    "sessionId": {
      "description": "Id of the new desktop session.",
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    }
  },
  "required": [
    "sessionId",
    "secret",
    "expiresAt"
  ],
  "type": "object",
  "x-kind": "view",
  "x-pii": "sensitive",
  "x-relations": [],
  "x-tenancyScope": "user"
}
