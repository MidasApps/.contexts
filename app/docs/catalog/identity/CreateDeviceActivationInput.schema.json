{
  "additionalProperties": false,
  "description": "Creates a one-time device activation code (core.device.create).",
  "examples": [
    {
      "label": "Front desk tablet",
      "node": {
        "level": "project",
        "projectId": "Pq4rS6tU8vW0xY2zA1bC",
        "tenantId": "Jd8sK2lPq0WnR5tYu3bV"
      },
      "roles": [
        {
          "key": "device",
          "kind": "system"
        }
      ]
    }
  ],
  "properties": {
    "label": {
      "description": "Name of the device to activate.",
      "maxLength": 80,
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
    "node": {
      "description": "Node the device will be granted at.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": "organization",
              "description": "Level of the node.",
              "type": "string",
              "x-pii": "none"
            },
            "tenantId": {
              "description": "Organization (tenant) of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            }
          },
          "required": [
            "level",
            "tenantId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": "project",
              "description": "Level of the node.",
              "type": "string",
              "x-pii": "none"
            },
            "projectId": {
              "description": "Project of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            },
            "tenantId": {
              "description": "Organization (tenant) of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            }
          },
          "required": [
            "level",
            "tenantId",
            "projectId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "level": {
              "const": "unit",
              "description": "Level of the node.",
              "type": "string",
              "x-pii": "none"
            },
            "projectId": {
              "description": "Project of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            },
            "tenantId": {
              "description": "Organization (tenant) of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            },
            "unitId": {
              "description": "Unit of the node.",
              "minLength": 1,
              "type": "string",
              "x-pii": "none"
            }
          },
          "required": [
            "level",
            "tenantId",
            "projectId",
            "unitId"
          ],
          "type": "object"
        }
      ],
      "x-pii": "none"
    },
    "roles": {
      "description": "Roles of the device grant (no escalation).",
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "key": {
                "description": "System role key.",
                "enum": [
                  "owner",
                  "admin",
                  "member",
                  "viewer",
                  "device"
                ],
                "type": "string",
                "x-pii": "none"
              },
              "kind": {
                "const": "system",
                "description": "A system role of every organization.",
                "type": "string",
                "x-pii": "none"
              }
            },
            "required": [
              "kind",
              "key"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "custom",
                "description": "A custom role of this organization.",
                "type": "string",
                "x-pii": "none"
              },
              "roleId": {
                "description": "Id of the custom role.",
                "minLength": 1,
                "type": "string",
                "x-pii": "none"
              }
            },
            "required": [
              "kind",
              "roleId"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array",
      "x-pii": "none"
    }
  },
  "required": [
    "label",
    "node",
    "roles"
  ],
  "type": "object",
  "x-kind": "command",
  "x-permission": "core.device.create",
  "x-pii": "none",
  "x-relations": [],
  "x-tenancyScope": "organization"
}
