{
  "description": "Registers an OpenAPI, MCP, Postgres or browser connector for the organization; its secret is set separately.",
  "examples": [
    {
      "config": {
        "allowedHosts": [
          "mcp.example.com"
        ],
        "auth": "none",
        "url": "https://mcp.example.com/mcp"
      },
      "name": "docs-mcp",
      "toolPolicy": {
        "allow": [
          "search"
        ],
        "readOnly": [
          "search"
        ]
      },
      "type": "mcp"
    }
  ],
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "config": {
          "additionalProperties": false,
          "description": "OpenAPI settings.",
          "properties": {
            "allowedHosts": {
              "description": "Hosts requests may reach, redirects included.",
              "items": {
                "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
                "type": "string"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array",
              "x-pii": "none"
            },
            "apiKeyHeader": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z0-9-]{1,100}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Header name for api-key auth; null otherwise.",
              "x-pii": "none"
            },
            "auth": {
              "description": "How the secret is sent; the secret itself is in the secret store.",
              "enum": [
                "none",
                "bearer",
                "api-key"
              ],
              "type": "string",
              "x-pii": "none"
            },
            "specUrl": {
              "description": "URL of the OpenAPI 3.0/3.1 document.",
              "format": "uri",
              "maxLength": 2048,
              "type": "string",
              "x-pii": "none"
            }
          },
          "required": [
            "specUrl",
            "allowedHosts",
            "auth",
            "apiKeyHeader"
          ],
          "type": "object",
          "x-pii": "none"
        },
        "name": {
          "description": "Display name; also the prefix of the generated tool names.",
          "maxLength": 100,
          "minLength": 1,
          "type": "string",
          "x-pii": "none"
        },
        "toolPolicy": {
          "additionalProperties": false,
          "description": "Tools agents may call and which skip approval.",
          "properties": {
            "allow": {
              "description": "Tools agents may call; anything else is hidden.",
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "type": "string"
              },
              "maxItems": 500,
              "type": "array",
              "x-pii": "none"
            },
            "readOnly": {
              "description": "Subset of allow that runs without approval.",
              "items": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
                "type": "string"
              },
              "maxItems": 500,
              "type": "array",
              "x-pii": "none"
