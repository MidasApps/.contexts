{
  "additionalProperties": false,
  "description": "Changes a connector's name, status, tool allowlist or config.",
  "examples": [
    {
      "status": "disabled"
    }
  ],
  "properties": {
    "config": {
      "additionalProperties": {},
      "description": "New config for the connector's type.",
      "propertyNames": {
        "type": "string"
      },
      "type": "object",
      "x-pii": "none"
    },
    "name": {
      "description": "New display name.",
      "maxLength": 100,
      "minLength": 1,
      "type": "string",
      "x-pii": "none"
    },
    "status": {
      "description": "Enable or disable the connector for agents.",
      "enum": [
        "active",
        "disabled"
      ],
      "type": "string",
      "x-pii": "none"
    },
    "toolPolicy": {
      "additionalProperties": false,
      "description": "New tool allowlist.",
      "properties": {
        "allow": {
          "description": "Tools agents may call; anything else is hidden.",
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 500,
          "type": "array",
          "x-pii": "none"
        },
        "readOnly": {
          "description": "Subset of allow that runs without approval.",
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 500,
          "type": "array",
          "x-pii": "none"
        }
      },
      "required": [
        "allow",
        "readOnly"
      ],
      "type": "object",
      "x-pii": "none"
    }
  },
  "type": "object",
  "x-kind": "command",
  "x-permission": "core.connector.write",
  "x-pii": "none",
  "x-relations": [],
  "x-tenancyScope": "organization"
}
