{
  "$schema": "https://turborepo.com/schema.json",
  // Agent guidance lives in ../.contexts; stop turbo from maintaining a root AGENTS.md.
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "lib/**", ".mastra/output/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    // Needs the Emulator Suite (root `pnpm test:emulators` wraps it in
    // `firebase emulators:exec`); the emulator hosts must reach the test process.
    "test:emulators": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "FIREBASE_*",
        "FIRESTORE_EMULATOR_HOST",
        "GCLOUD_PROJECT",
        "PUBSUB_EMULATOR_HOST",
        "STORAGE_EMULATOR_HOST"
      ]
    },
    // Needs the compose Postgres (`docker compose up -d --wait`).
    "test:postgres": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    // Agent eval sets (packages/agents): fake models in CI, real ones opt-in.
    "evals": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["AI_*", "DATABASE_URL"]
    },
    "evals:real": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "AI_*",
        "DATABASE_URL",
        "GOOGLE_*",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Catalog tasks write and read app/docs, outside any package, so they are never cached.
    "contracts:catalog": { "cache": false },
    "contracts:check": { "cache": false },
    // Reads packages/i18n and every modules/*/src/messages catalog; cheap, so never cached.
    "i18n:check": { "cache": false },
    // Started by scripts/dev.ts (root `pnpm dev`), which also runs compose and the emulators.
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["WEB_PORT"]
    }
  }
}
