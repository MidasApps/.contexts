rules_version = '2';

// Deny by default: clients get no direct access until a collection gets its own
// match block with tenant checks (contracts/firebase-firestore.md §7, §19).
// Server code uses the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Uploaded file records (SP3 files context): written by the Admin SDK only; clients
    // read them through `GET /v1/files/{fileId}`, never directly.
    match /files/{fileId} {
      allow read, write: if false;
    }
  }
}
